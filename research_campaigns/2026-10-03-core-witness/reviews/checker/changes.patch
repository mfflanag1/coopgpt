+class CliOptimizedTests(unittest.TestCase):
+    """Run the CLI under ``python -O`` to prove checks are not asserts."""
+
+    def run_cli(self, text):
+        handle, path = tempfile.mkstemp(suffix=".json")
+        try:
+            with os.fdopen(handle, "w", encoding="utf-8") as out:
+                out.write(text)
+            return subprocess.run(
+                [sys.executable, "-O", CHECKER_PATH, path],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                universal_newlines=True,
+                timeout=120,
+            )
+        finally:
+            os.unlink(path)
+
+    def test_accepts_valid(self):
+        proc = self.run_cli(json.dumps(m2_empty()))
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        result = json.loads(proc.stdout)
+        self.assertEqual(result["lower"], "-1/3")
+        self.assertEqual(result["upper"], "1")
+
+    def test_rejects_invalid_under_O(self):
+        mutations = []
+        cert = m2_empty()
+        cert["witnesses"][0] = [1, 0, 0, 0, 0, 0]
+        cert["primal_J"] = "-1/6"
+        mutations.append(cert)
+        cert = m2_empty()
+        cert["matrices"][0][0][1] = "1/2"
+        mutations.append(cert)
+        cert = m2_empty()
+        cert["dual"]["upper"] = 0
+        mutations.append(cert)
+        cert = m1_empty()
+        cert["unmatched"] = [0, 1]
+        mutations.append(cert)
+        cert = m1_empty()
+        cert["matrices"][0][0][0] = 1.0
+        mutations.append(cert)
+        for cert in mutations:
+            proc = self.run_cli(json.dumps(cert))
+            self.assertEqual(proc.returncode, 1, proc.stdout)
+            self.assertIn("REJECTED", proc.stderr)
+
+    def test_rejects_bad_json(self):
+        good = json.dumps(m1_perfect())
+        self.assertEqual(self.run_cli(good).returncode, 0)
+        self.assertEqual(self.run_cli("{not json").returncode, 1)
+        nan_text = good.replace('"primal_J": 0', '"primal_J": NaN')
+        self.assertNotEqual(nan_text, good)
+        self.assertEqual(self.run_cli(nan_text).returncode, 1)
+        dup_text = good[:-1] + ', "m": 1}'
+        self.assertEqual(self.run_cli(dup_text).returncode, 1)
+
+    def test_usage(self):
+        self.assertEqual(check_certificate.main([]), 2)
+
